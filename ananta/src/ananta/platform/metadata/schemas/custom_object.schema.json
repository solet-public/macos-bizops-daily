{
  "title": "Custom Object Schema",
  "description": "Schema for custom objects within AI Apps",
  "type": "object",
  "required": ["fields"],
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 500,
      "description": "Description of this custom object"
    },
    "fields": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_]*[a-z0-9]$": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["string", "integer", "number", "boolean", "array", "object", "geolocation", "datetime"],
              "description": "Data type of the field"
            },
            "required": {
              "type": "boolean",
              "default": true,
              "description": "Whether this field is required"
            },
            "description": {
              "type": "string",
              "maxLength": 200,
              "description": "Description of this field"
            },
            "validation": {
              "type": "string",
              "description": "Validation rule for this field"
            },
            "default": {
              "description": "Default value for this field"
            },
            "enum": {
              "type": "array",
              "description": "Allowed values for this field"
            },
            "format": {
              "type": "string",
              "description": "Format specification for the field"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "minProperties": 1,
      "description": "Fields that define the structure of this object"
    },
    "actions": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_]*[a-z0-9]$": {
          "type": "object",
          "required": ["description", "executor"],
          "properties": {
            "description": {
              "type": "string",
              "maxLength": 200,
              "description": "Description of what this action does"
            },
            "executor": {
              "type": "string",
              "pattern": "^[a-z_]+::[a-z_]+::[a-z_]+$",
              "description": "Process key that executes this action"
            },
            "parameters": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "required": ["name", "type"],
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "type": {
                        "type": "string"
                      },
                      "required": {
                        "type": "boolean",
                        "default": true
                      },
                      "description": {
                        "type": "string"
                      }
                    }
                  }
                ]
              },
              "description": "Parameters required by this action"
            },
            "return_value": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "schema": {
                  "type": "object"
                }
              },
              "description": "Description of the value returned by this action"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "description": "Actions that can be performed on this object"
    },
    "validation_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "rule"],
        "properties": {
          "field": {
            "type": "string"
          },
          "rule": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "description": "Custom validation rules for this object"
    }
  },
  "additionalProperties": false
}