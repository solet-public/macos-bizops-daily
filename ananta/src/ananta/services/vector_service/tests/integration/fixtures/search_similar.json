{
  "name": "test_search_similar",
  "description": "Store vectors and search for similar results.",
  "sequence": [
    {
      "step": "precleanup_vector_search_a",
      "process_key": "service_interface::state_service::delete_records",
      "arguments": {
        "namespace": "pgvector_service_plugin",
        "query": {
          "table": "embeddings",
          "filters": {
            "id": "vector_search_a"
          },
          "soft_delete": false
        }
      }
    },
    {
      "step": "precleanup_vector_search_b",
      "process_key": "service_interface::state_service::delete_records",
      "arguments": {
        "namespace": "pgvector_service_plugin",
        "query": {
          "table": "embeddings",
          "filters": {
            "id": "vector_search_b"
          },
          "soft_delete": false
        }
      }
    },
    {
      "step": "store_vectors",
      "process_key": "service_interface::vector_service::store_vectors",
      "arguments": {
        "namespace": "pgvector_service_plugin",
        "vectors": [
          {
            "id": "vector_search_a",
            "vector": [
              0.15,
              0.32,
              -0.21
            ],
            "dimension": 3,
            "metadata": {
              "label": "search_a",
              "category": "search"
            }
          },
          {
            "id": "vector_search_b",
            "vector": [
              -0.41,
              0.05,
              0.29
            ],
            "dimension": 3,
            "metadata": {
              "label": "search_b",
              "category": "search"
            }
          }
        ]
      }
    },
    {
      "step": "search_similar",
      "process_key": "service_interface::vector_service::search_similar",
      "arguments": {
        "namespace": "pgvector_service_plugin",
        "query_vector": [
          0.14,
          0.3,
          -0.2
        ],
        "limit": 5,
        "filters": {}
      }
    },
    {
      "step": "cleanup_delete_vectors",
      "process_key": "service_interface::vector_service::delete_vectors",
      "arguments": {
        "namespace": "pgvector_service_plugin",
        "vector_ids": [
          "vector_search_a",
          "vector_search_b"
        ]
      }
    },
    {
      "step": "cleanup_vector_search_a",
      "process_key": "service_interface::state_service::delete_records",
      "arguments": {
        "namespace": "pgvector_service_plugin",
        "query": {
          "table": "embeddings",
          "filters": {
            "id": "vector_search_a"
          },
          "soft_delete": false
        }
      }
    },
    {
      "step": "cleanup_vector_search_b",
      "process_key": "service_interface::state_service::delete_records",
      "arguments": {
        "namespace": "pgvector_service_plugin",
        "query": {
          "table": "embeddings",
          "filters": {
            "id": "vector_search_b"
          },
          "soft_delete": false
        }
      }
    }
  ]
}