{
  "name": "test_list_memories_different_sorts",
  "description": "Test listing memories with different sort options",
  "sequence": [
    {
      "step": "create_test_memory",
      "process_key": "service_interface::memory_service::remember",
      "arguments": {
        "content": "Test memory for sort verification in list operation.",
        "tags": ["test-sort"]
      },
      "capture": {
        "memory_id": {
          "source": "output",
          "output_key": "Memory ID"
        }
      }
    },
    {
      "step": "list_by_strength",
      "process_key": "service_interface::memory_service::list_memories",
      "arguments": {
        "sort_by": "strength",
        "limit": 5
      }
    },
    {
      "step": "list_by_created",
      "process_key": "service_interface::memory_service::list_memories",
      "arguments": {
        "sort_by": "created_at",
        "limit": 5
      }
    },
    {
      "step": "list_by_retrieval_count",
      "process_key": "service_interface::memory_service::list_memories",
      "arguments": {
        "sort_by": "retrieval_count",
        "limit": 5
      }
    },
    {
      "step": "cleanup_forget",
      "process_key": "service_interface::memory_service::forget",
      "arguments": {
        "memory_id": "${memory_id}"
      }
    }
  ]
}
