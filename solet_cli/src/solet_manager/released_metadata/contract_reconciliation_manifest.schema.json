        "manifest_entry_id": {
          "minLength": 1,
          "type": "string"
        },
        "source_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "manifest_entry_id",
        "source_digest",
        "destination_digest"
      ],
      "type": "object"
    },
    "source_identity": {
      "additionalProperties": false,
      "properties": {
        "flow_contract_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
