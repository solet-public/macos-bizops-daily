        "flow_source_revision": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "flow_id",
        "flow_source_revision",
        "flow_contract_digest"
      ],
      "type": "object"
    },
    "stage_probe": {
      "additionalProperties": false,
      "properties": {
        "boundary": {
          "enum": [
            "entry",
            "exit"
          ]
        },
        "probe_id": {
          "minLength": 1,
          "type": "string"
        },
        "stage_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "stage_id",
        "boundary",
        "probe_id"
      ],
      "type": "object"
    }
  },
