    "destination_identity": {
      "additionalProperties": false,
      "properties": {
        "flow_contract_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "flow_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "flow_id",
        "flow_contract_digest"
      ],
      "type": "object"
    },
    "first_use_migration_citation": {
      "additionalProperties": false,
      "properties": {
        "destination_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
