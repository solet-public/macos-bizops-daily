{
  "name": "test_update_metadata_basic",
  "description": "Update metadata for an existing blob",
  "process_key": "plugin::default_blob_storage_plugin::update_blob_metadata",
  "arguments": {
    "params": {
      "namespace": "test_namespace",
      "blob_id": "gen-abc123xyz4567",
      "metadata": {
        "description": "Updated description",
        "tags": "new,updated,tags"
      }
    },
    "state": {
      "current_session_id": "test-update-basic-001"
    },
    "timeout_seconds": 30
  },
  "requires_setup": {
    "store_blob_first": true,
    "use_returned_blob_id": true
  }
}
