{
  "name": "test_get_metadata_basic",
  "description": "Get metadata for an existing blob without retrieving content",
  "process_key": "plugin::default_blob_storage_plugin::get_blob_metadata",
  "arguments": {
    "params": {
      "namespace": "test_namespace",
      "blob_id": "gen-abc123xyz4567"
    },
    "state": {
      "current_session_id": "test-getmeta-basic-001"
    },
    "timeout_seconds": 30
  },
  "requires_setup": {
    "store_blob_first": true,
    "use_returned_blob_id": true
  }
}
