{
  "name": "test_search_blobs_with_pagination",
  "description": "Search blobs with limit and offset pagination",
  "process_key": "plugin::default_blob_storage_plugin::search_blobs",
  "arguments": {
    "params": {
      "namespace": "test_namespace",
      "metadata_filters": {
        "limit": 10,
        "offset": 0
      }
