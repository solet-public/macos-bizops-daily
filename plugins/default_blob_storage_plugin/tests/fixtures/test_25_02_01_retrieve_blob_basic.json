{
  "name": "test_retrieve_blob_basic",
  "description": "Retrieve a previously stored blob by its ID",
  "process_key": "plugin::default_blob_storage_plugin::retrieve_blob",
  "arguments": {
    "params": {
      "namespace": "test_namespace",
      "blob_id": "gen-abc123xyz4567"
    },
    "state": {
      "current_session_id": "test-retrieve-basic-001"
    },
    "timeout_seconds": 30
  },
  "requires_setup": {
    "store_blob_first": true,
    "use_returned_blob_id": true
  }
}
