{
  "name": "test_search_blobs_by_original_name",
  "description": "Search blobs by partial original filename match",
  "process_key": "plugin::default_blob_storage_plugin::search_blobs",
  "arguments": {
    "params": {
      "namespace": "test_namespace",
      "metadata_filters": {
        "original_name": "photo"
      }
