{
  "name": "test_learn_with_memorize",
  "description": "Verify learning with immediate addition to spaced repetition memorization queue",
  "process_key": "plugin::actr_memory_plugin::learn_action",
  "arguments": {
    "params": {
      "path": "/tmp/important_facts.md",
      "memorize": true,
      "tags": ["critical", "must-remember"]
    },
    "state": {
      "session_id": "test-session-072"
    }
  },
  "timeout_seconds": 60
}
