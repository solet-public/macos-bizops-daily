{
  "name": "test_update_metadata_nested",
  "description": "Update metadata with nested objects and arrays",
  "process_key": "plugin::pgvector_service_plugin::update_metadata_action",
  "arguments": {
    "params": {
      "namespace": "pgvector_service_plugin",
      "vector_id": "test-vector-id-001",
      "metadata": {
        "nested": {
          "level1": {
            "level2": "deep_value"
          }
        },
        "array_field": ["item1", "item2", "item3"],
        "tags": {"primary": "test", "secondary": "nested"}
      }
    },
    "state": {
      "current_session_id": "test-update-nested-001"
    },
    "timeout_seconds": 30
  }
}
