{
  "name": "test_execute_in_seconds_long_delay",
  "description": "Schedule a one-time execution with a 5 minute (300 seconds) delay",
  "process_key": "plugin::default_scheduling_plugin::execute_in_seconds",
  "arguments": {
    "params": {
      "seconds": 300,
      "label": "Processing Completion Notification",
      "tags": "notification,delayed",
      "actions": [
        {
          "process_key": "plugin::discord_plugin::post_message",
          "arguments": {
            "message": "Your batch processing should be complete now. Check the results."
          }
        }
      ]
    },
    "state": {
      "session_id": "test-session-103",
      "flow_id": "test-flow-103"
    }
  },
  "timeout_seconds": 30
}
