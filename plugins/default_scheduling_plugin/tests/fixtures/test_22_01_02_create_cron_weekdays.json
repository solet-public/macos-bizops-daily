{
  "name": "test_create_cron_weekdays",
  "description": "Create a cron schedule for weekday execution only (Mon-Fri at 9am)",
  "process_key": "plugin::default_scheduling_plugin::create_cron_schedule",
  "arguments": {
    "params": {
      "cron_expression": "0 9 * * 1-5",
      "label": "Weekday Morning Report",
      "tags": "reports,weekdays,morning",
      "actions": [
        {
          "process_key": "plugin::reporting_plugin::generate_report",
          "arguments": {
            "report_type": "summary"
          }
        },
        {
          "process_key": "plugin::discord_plugin::post_message",
          "arguments": {
            "message": "Weekday report is ready"
          }
        }
      ]
    },
    "state": {
      "session_id": "test-session-002",
      "flow_id": "test-flow-002"
    }
  },
  "timeout_seconds": 30
}
