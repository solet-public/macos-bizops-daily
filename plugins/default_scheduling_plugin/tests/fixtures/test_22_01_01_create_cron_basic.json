{
  "name": "test_create_cron_basic",
  "description": "Create a basic cron schedule with daily execution at 9am",
  "process_key": "plugin::default_scheduling_plugin::create_cron_schedule",
  "arguments": {
    "params": {
      "cron_expression": "0 9 * * *",
      "label": "Daily Morning Report",
      "tags": "reports,daily",
      "actions": [
        {
          "process_key": "plugin::discord_plugin::post_message",
          "arguments": {
            "message": "Daily report generated"
          }
        }
      ]
    },
    "state": {
      "session_id": "test-session-001",
      "flow_id": "test-flow-001"
    }
  },
  "timeout_seconds": 30
}
